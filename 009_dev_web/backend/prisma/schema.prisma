generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------
// 1. SEGURIDAD (RBAC)
// ---------------------------

model Role {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(50)
  UserRoles UserRole[]

  @@map("roles")
}

model User {
  id            Int         @id @default(autoincrement())
  username      String      @unique @db.VarChar(50)
  password_hash String      @db.VarChar(255)
  UserRoles     UserRole[]

  @@map("users")
}

model UserRole {
  user_id Int
  role_id Int
  Role    Role   @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User    User   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, role_id])
  @@map("userroles")
}

// ---------------------------
// 2. DOMINIO (ACTIVOS Y RIESGOS)
// ---------------------------

model Category {
  id     Int      @id @default(autoincrement())
  name   String   @unique @db.VarChar(100)
  Assets Asset[]

  @@map("categories")
}

model Hazard {
  id                  Int                   @id @default(autoincrement())
  name                String                @unique @db.VarChar(100)
  AssetHazardExposure AssetHazardExposure[]

  @@map("hazards")
}

model Condition {
  id              Int               @id @default(autoincrement())
  name            String            @unique @db.VarChar(100)
  AssetConditions AssetCondition[]

  @@map("conditions")
}

model Asset {
  id                  Int                   @id @default(autoincrement())
  name                String                @db.VarChar(255)
  latitude            Float
  longitude           Float
  category_id         Int
  base_value          Decimal               @db.Decimal(15, 2)
  created_at          DateTime?             @default(now())
  Category            Category              @relation(fields: [category_id], references: [id])
  AssetHazardExposure AssetHazardExposure[]
  AssetConditions     AssetCondition[]

  @@map("assets")
}

model AssetHazardExposure {
  id             Int     @id @default(autoincrement())
  asset_id       Int
  hazard_id      Int
  exposure_value Decimal @db.Decimal(15, 2)
  Asset          Asset   @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  Hazard         Hazard  @relation(fields: [hazard_id], references: [id], onDelete: Cascade)

  @@unique([asset_id, hazard_id])
  @@map("assethazardexposure")
}

model AssetCondition {
  asset_id     Int
  condition_id Int
  Asset        Asset     @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Condition    Condition @relation(fields: [condition_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([asset_id, condition_id])
  @@map("assetconditions")
}
